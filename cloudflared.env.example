# Copy this file to /data/cloudflared/cloudflared.env on the gateway.
# Then set TUNNEL_TOKEN to the token of your tunnel.
# You find the token in the Cloudflare dashboard, on the page of your tunnel.
# To add a replica, use the same token as your first connector.
TUNNEL_TOKEN=

# To update cloudflared each week, remove the "#" from the next line.
# Then run: /data/cloudflared/udm-cloudflared.sh install
#AUTO_UPDATE=true
